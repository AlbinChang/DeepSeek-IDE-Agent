.llm/

# 忽略运行时记忆目录（用户指令与防重复犯错记忆）
.memory/

# 忽略 test-project
test-project*

# 忽略 Eclipse/JDTLS 产生的元数据文件 (对齐 41.10 节)
.classpath
.project
.settings/
.factorypath
bin/
target/

# 忽略 Playwright 报告与测试输出
test-results/
playwright-report/
test_output*.txt
test_output_nav_*.txt

# 忽略 Jacoco/测试覆盖率
jacoco-extract/
*.md_coverage*
