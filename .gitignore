# 忽略其他中间文件
server/undefined/
client/test-results/
client/tests/results/
client/test_output.txt
client/test_output_*.txt

# 忽略tests
tests/

# ===== Open-source 安全忽略（防止敏感信息泄露） =====
# 环境变量（保留示例文件）
.env.*
!.env.example
!.env.*.example

# 本地私钥/证书/签名文件
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# 常见密钥与凭据落地文件
secrets/
secret/
**/secrets/*.json
**/*token*.txt
**/*apikey*.txt

# 运行时缓存与本地工作数据
.temp/
.tmp-image-check/
.cache/

# 本地编辑器/会话状态
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json

.github/
.claude/
.rules/

.electron-store/