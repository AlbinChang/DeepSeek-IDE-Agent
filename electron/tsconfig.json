{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "dist/main",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noEmit": true,
    "sourceMap": true,
    "paths": {
      "@/*": ["../server/src/*"],
      "@server/*": ["../server/src/*"]
    },
    "baseUrl": "."
  },
  "include": ["src/main/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
