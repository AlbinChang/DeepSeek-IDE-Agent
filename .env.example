# =============================================================================
# Web IDE Agent — 环境变量配置模板
# =============================================================================
# 复制此文件为 .env 并根据实际环境修改。
# 所有变量均有合理默认值，仅需配置标注 [必需] 的项即可启动。


# =============================================================================
# 1. 运行时环境 (Runtime)
# =============================================================================
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
PORT_RETRY_LIMIT=20

# 终端服务器 (Terminal PTY Server)
TERMINAL_SERVER_PORT=3003

# 前端开发服务器端口 (Vite dev server)
DEV_PORT=5174

# 工作区根目录 (可选，留空则通过前端动态选择)
WORKSPACE_ROOT=


# =============================================================================
# 2. AI 模型配置 (DeepSeek / OpenAI-Compatible)
# =============================================================================
# [必需] DeepSeek API Key
DEEPSEEK_API_KEY=your_api_key_here

# API 基址 (默认 DeepSeek 官方)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型 ID (deepseek-chat / deepseek-reasoner)
DEEPSEEK_MODEL=deepseek-chat


# =============================================================================
# 3. 日志与调试 (Logging & Debug)
# =============================================================================
# 详细请求日志 (Fastify logger 开关，生产环境建议关闭)
ENABLE_VERBOSE_LOGS=false

# 调试日志 (Agent 工具调用/评估等内部调试输出)
DEBUG_LOG=false

# 文件日志级别: SILENT | ERROR | WARN | INFO | DEBUG
LOG_LEVEL=INFO


# =============================================================================
# 4. Agent 记忆 (Memory)
# =============================================================================
# 最多存储用户指令数（user_instructs.json，硬上限 20，只能调低）
AGENT_MAX_STORED_INSTRUCTIONS=20

# 会话历史保留最近轮数
AGENT_SESSION_HISTORY_KEEP_LAST=10


# =============================================================================
# 5. Agent 运行时 (Runtime Limits)
# =============================================================================
# LLM 网络层错误自动重试次数 (DNS/连接/流中断等，默认 3)
AGENT_API_RETRY_LIMIT=3

# LLM 服务过载类错误自动重试次数
# (HTTP 408/429/500/502/503/504，如 DeepSeek "503 Service is too busy"，默认 100)
AGENT_API_SERVICE_BUSY_RETRY_LIMIT=10

# 对话历史上限 (字节，默认 1MB)
AGENT_MAX_HISTORY_BYTES=1048576

# 对话历史低水位线 (字节，默认 128KB，裁剪到此阈值)
AGENT_LOW_WATERMARK_BYTES=131072

# 模型输出守卫：拦截 BOS/EOS 等控制标记被当成正文输出的异常响应
# （通常是服务端 chat template 用错、未跳过特殊 token、base 权重或模型被替换），
# 拦截后不会写入会话历史。默认 true，仅在排障时可关闭。
AGENT_MODEL_OUTPUT_GUARD=true


# =============================================================================
# 6. 文件读取限制 (read_file tool)
# =============================================================================
AGENT_READ_FILE_MAX_LINES=3000
AGENT_READ_FILE_MAX_FILE_SIZE_BYTES=204800
AGENT_READ_FILE_MAX_CONTENT_BYTES=204800
AGENT_READ_FILE_LONG_LINE_THRESHOLD=1000


# =============================================================================
# 7. Git 与代码检查 (Git & Syntax)
# =============================================================================
# Git 历史记录最大条数
AGENT_GIT_HISTORY_LIMIT=50

# 语法检查批量最大文件数
AGENT_SYNTAX_CHECK_MAX_FILES=20

# 语法检查命令超时 (毫秒)
AGENT_SYNTAX_CHECK_TIMEOUT_MS=15000


# =============================================================================
# 8. 浏览器自动化 (Browser MCP / Playwright)
# =============================================================================
# 浏览器类型 (chrome / firefox / webkit)
BROWSER_MCP_BROWSER=chrome

# 无头模式 (true=后台运行)
BROWSER_MCP_HEADLESS=false

# 页面导航超时 (毫秒)
BROWSER_MCP_TIMEOUT_NAVIGATION=120000

# 单次操作超时 (毫秒)
BROWSER_MCP_TIMEOUT_ACTION=10000

# 允许访问本地 file:// 协议 (默认开启)
BROWSER_MCP_ALLOW_UNRESTRICTED_FILE_ACCESS=true

# 忽略 HTTPS 证书错误 (本地开发常用自签名证书)
BROWSER_MCP_IGNORE_HTTPS_ERRORS=false

# 禁用沙箱 (Docker / CI 环境需开启)
BROWSER_MCP_NO_SANDBOX=false

# 自定义视口大小 (宽x高，如 1280x720)
BROWSER_MCP_VIEWPORT_SIZE=

# 隔离模式 (每次会话独立 profile，不持久化)
BROWSER_MCP_ISOLATED=false

# 浏览器空闲回收时间 (毫秒)
BROWSER_SESSION_IDLE_MS=600000

# =============================================================================
# 9. Workflow 编排 (.workflow)
# =============================================================================
# 总开关；关闭后 workflow:run/cancel/resume 直接拒绝（只读接口仍可用）
WORKFLOW_ENABLED=true
# 自动触发工作流会执行工作区声明的流程；仅在信任工作区时显式启用
WORKFLOW_TRIGGERS_ENABLED=false

# utilityProcess Worker 上限（worker-per-run；留空 = min(4, CPU 核数 - 1)）
WORKFLOW_MAX_WORKERS=

# 排队 run 上限
WORKFLOW_MAX_QUEUE_SIZE=20

# 同一 workflow 的并发 run 上限
WORKFLOW_MAX_CONCURRENT_RUNS_PER_WORKFLOW=1

# 单次 run 最大执行时长（毫秒，默认 2 小时）
WORKFLOW_MAX_RUN_DURATION_MS=7200000

# Worker 堆上限（MB）
WORKFLOW_WORKER_HEAP_MB=512

# 心跳间隔 / 超时（毫秒）
WORKFLOW_HEARTBEAT_INTERVAL_MS=5000
WORKFLOW_HEARTBEAT_TIMEOUT_MS=30000

# Worker 启动就绪超时 / 取消后强制回收宽限期（毫秒）
WORKFLOW_WORKER_READY_TIMEOUT_MS=15000
WORKFLOW_CANCEL_GRACE_MS=8000

# Worker 复用与崩溃重启策略（Phase 1.5 为 worker-per-run，保留给热池）
WORKFLOW_MAX_RUNS_PER_WORKER=20
WORKFLOW_MAX_WORKER_RESTARTS=3
WORKFLOW_WORKER_RESTART_WINDOW_MS=300000

# 运行记录保留数量
WORKFLOW_MAX_STORED_RUNS=50

# 单 run 预算
WORKFLOW_MAX_STEPS=200
# 单个 fork 同时运行的分支上限
WORKFLOW_MAX_FORK_PARALLEL=4
# 已报告的模型 token 预算；0 关闭。并行/在途请求和失败请求可能超出预算。
WORKFLOW_MAX_TOKENS=0
WORKFLOW_MAX_SUBWORKFLOW_DEPTH=3
WORKFLOW_MAX_STEP_OUTPUT_CHARS=65536
WORKFLOW_DEFAULT_STEP_TIMEOUT_MS=600000

# Agent 步骤默认最大轮次
WORKFLOW_AGENT_STEP_MAX_TURNS=12

# 同一 provider:model 同时执行的 agent/evaluator 步骤上限（跨 Worker 生效）
WORKFLOW_AGENT_CONCURRENCY_PER_PROVIDER=2

# 每个 provider:model 每分钟模型请求数（含重试）；0 关闭限速，burst 为突发容量
WORKFLOW_AGENT_REQUESTS_PER_MINUTE=0
WORKFLOW_AGENT_REQUEST_BURST=2

# HTTP 步骤：默认禁止私网；响应上限与超时
WORKFLOW_HTTP_ALLOW_PRIVATE=false
WORKFLOW_HTTP_MAX_RESPONSE_BYTES=1048576
WORKFLOW_HTTP_TIMEOUT_MS=60000

# 独立服务的 Workflow REST/SSE 接口默认关闭；启用时必须设置独立 Bearer token。
WORKFLOW_HTTP_API_ENABLED=false
WORKFLOW_HTTP_API_TOKEN=
